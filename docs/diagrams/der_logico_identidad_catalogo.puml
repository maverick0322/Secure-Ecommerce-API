  + *updatedAt : DATETIME(3)
  + deletedAt : DATETIME(3)
}

class "product_categories" as TProdCat <<table>> {
  + *productId : INT <<PK, FK>>
  + *categoryId : INT <<PK, FK>>
  --
  + *createdAt : DATETIME(3)
  + deletedAt : DATETIME(3)
}

