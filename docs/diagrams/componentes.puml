' TRACE: backendnode/index.js; backendnode/routes/auth.routes.js; backendnode/routes/products.routes.js; backendnode/routes/orders.routes.js; backendnode/middlewares/auth.middleware.js; backendnode/services/catalog.service.js; backendnode/models/index.js; frontendnet/Program.cs; frontendnet/Controllers/AuthController.cs; frontendnet/Services/SessionTokenManager.cs; frontendnet/Middlewares/RefreshTokenDelegatingHandler.cs
@startuml componentes
!include _skin.puml
left to right direction
skinparam Nodesep 48
skinparam Ranksep 64
title Diagrama de Componentes UML 2.5.1 — Arquitectura Lógica (CMP-01)
caption 13 componentes y 4 contenedores/paquetes (límite: máx. 14 componentes y 4 paquetes)

package "frontendnet (ASP.NET Core 9.0 MVC BFF)" <<frontend>> {
  component "SecurityHeadersMiddleware +\nCloudflareTurnstileService" as C_FeSec <<control>>
  component "Controllers MVC + Razor Views\n(12 Controllers, 56 .cshtml)" as C_FeMvc <<boundary>>
  component "SessionTokenManager +\nDelegatingHandlers" as C_FeSession <<control>>
  component "Typed HttpClients\n(Auth, Product, Cart, Orders...)" as C_FeClients <<boundary>>

  C_FeSec ..> C_FeMvc
  C_FeMvc ..> C_FeClients
  C_FeClients ..> C_FeSession
}

interface "REST API\n/api/* + /health" as I_RestApi

package "backendnode (Node.js 24 LTS / Express 4)" <<backend>> {
  component "Security Edge + Routes\n(Helmet, CORS, RateLimit, Authorize)" as C_BeEdge <<boundary>>
  component "HTTP Controllers\n(11 Controllers)" as C_BeCtrl <<boundary>>
  component "Identity, Auth & Session Services\n(RS256, scrypt, OTP, Lockout)" as C_BeAuth <<control>>
  component "Catalog, Image Pipeline,\nCart & Orders Services" as C_BeDomain <<control>>
  component "Sequelize Models & Validators\n(14 Models, 4 Validators)" as C_BeModels <<entity>>

  C_BeEdge ..> C_BeCtrl
  C_BeCtrl ..> C_BeAuth
  C_BeCtrl ..> C_BeDomain
  C_BeAuth ..> C_BeModels
  C_BeDomain ..> C_BeModels
}

package "Persistencia y Estado" {
  interface "RESP TLS :6379" as I_Redis
  interface "MySQL :3306" as I_MySql
  component "Redis 8.2 TLS\n(Sesiones, RateLimit, Cuotas)" as C_Redis <<cache>>
  component "MySQL 8.4\n(14 tablas InnoDB)" as C_MySql <<database>>
  I_Redis - C_Redis
  I_MySql - C_MySql
}

package "Proveedores Externos" {
  interface "HTTPS Gmail\nOAuth2" as I_Gmail
  interface "HTTPS\nCloudinary" as I_Cloud
  component "Gmail OAuth2 API" as C_Gmail <<external>>
  component "Cloudinary Media API" as C_Cloud <<external>>
  I_Gmail - C_Gmail
  I_Cloud - C_Cloud
}

C_FeClients -( I_RestApi
I_RestApi - C_BeEdge
C_BeAuth -( I_Redis
C_BeDomain -( I_Redis
C_BeModels -( I_MySql
C_BeAuth -( I_Gmail
C_BeDomain -( I_Cloud
@enduml
