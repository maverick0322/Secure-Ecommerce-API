# Dependencias de Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Variables de entorno y secretos
.env
.env.local
.env.*.local
config/config.json

# Scripts y volcados de base de datos (ignorar dumps generales pero incluir script de inicialización)
*.sql
!bd.sql

# Pruebas REST Client (pueden contener tokens y contraseñas según pág. 70)
restclient/

# Archivos de registro / logs
log/*.txt
log/cloudinary/
log/stage4/
log/stage5/
*.log

# Archivos cargados por usuarios (uploads)
uploads/*
!uploads/.gitkeep

# Artefactos del sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Documentación OpenAPI generada localmente
swagger-output.json

# Reportes de cobertura de pruebas (Jest)
coverage/
*.lcov

# Directorio de compilación de documentación (Asciidoctor)
dist/

# Private exports, credentials and backup archives
.env.*
!.env.example
!.env.*.example
log/**
!log/.gitkeep
*.sql.*
*.dump
*.bak
*.pem
*.key
*.tar
*.tar.gz
*.tgz
*.zip
.aws/
.secrets/

