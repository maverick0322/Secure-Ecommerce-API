{
  "name": "backendnode",
  "version": "1.0.0",
  "description": "Backend API REST en Node.js para E-Commerce con enfoque en Programación Segura",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "start": "node --env-file=.env --watch index.js",
    "dev": "node --env-file=.env --watch index.js",
    "swagger": "node swagger.js",
    "migrate": "sequelize db:migrate",
    "migrate:undo": "sequelize db:migrate:undo:all",
    "seed": "sequelize db:seed:all",
    "seed:undo": "sequelize db:seed:undo:all"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "mysql",
    "jwt",
    "secure-programming",
    "ecommerce"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.11.3",
    "request-ip": "^3.3.0",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.1.0",
    "swagger-autogen": "^2.23.7"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "braces": "^3.0.3",
    "chokidar": "^3.6.0",
    "argparse": "^2.0.1",
    "js-yaml": "^4.1.0"
  }
}
