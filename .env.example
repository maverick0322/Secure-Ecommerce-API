# ============================================================
# SECURE ECOMMERCE API - ENVIRONMENT CONFIGURATION
# ============================================================
# Archivo de ejemplo. NO incluir credenciales reales.
# Copiar a .env y configurar los valores correspondientes.
# No modificar ni reinicializar la base de datos existente.


# ============================================================
# 1. DATABASE - MYSQL
# ============================================================

# Conexión desde Windows
DB_HOST=127.0.0.1
DB_PORT=3307

# Conexión desde Docker
DOCKER_DB_HOST=db
DOCKER_DB_PORT=3306

# Credenciales
DB_DATABASE=secure_ecommerce
DB_USER=ecommerce_app
DB_PASSWORD=

# UUID de la instancia autorizada de MySQL
DB_EXPECTED_UUID=




# ============================================================
# 2. API SERVER
# ============================================================

SERVER_PORT=3000
NODE_ENV=development

# Orígenes permitidos para el frontend
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

# Almacenamiento de archivos
FILES_IN_DB=false


# ============================================================
# 3. JWT SECRET - CHECKOUT HMAC
# ============================================================


JWT_SECRET=


# ============================================================
# 4. AUTHENTICATION - JWT RS256
# ============================================================

# Access tokens firmados mediante RS256.
# No existe fallback a HS256.

JWT_RS256_ISSUER=secure-ecommerce-api
JWT_RS256_AUDIENCE=secure-ecommerce-api-access
JWT_RS256_ACTIVE_KID=access-v1

# Clave privada del servidor
JWT_RS256_PRIVATE_KEY_PATH=.secrets/auth/access-private.pem

# Manifiesto de claves públicas para Windows
JWT_RS256_PUBLIC_KEYS_PATH=.secrets/auth/public-keys.windows.json

# Docker utiliza su propio manifiesto mediante compose.yaml.
# Las rutas relativas deben permanecer dentro de .secrets.

# Raíces adicionales autorizadas (opcional)
AUTH_CONFIG_ALLOWED_ROOTS=[]

# Clave binaria para versionado de credenciales
AUTH_CREDENTIAL_VERSION_KEY_PATH=.secrets/auth/credential-version.key


# ============================================================
# 5. REDIS - AUTHENTICATION SESSIONS
# ============================================================

# Configuración para ejecutar Node.js desde Windows.
# Docker utiliza los valores específicos de compose.yaml.

AUTH_REDIS_HOST=127.0.0.1
AUTH_REDIS_PORT=6380
AUTH_REDIS_TLS=true

# Usuario ACL
AUTH_REDIS_USER=auth_session_app

# Contraseña almacenada en archivo protegido
AUTH_REDIS_PASSWORD_PATH=.secrets/redis/app-password

# Certificado CA para verificar TLS
AUTH_REDIS_CA_PATH=.secrets/redis/ca.crt

# Namespace de sesiones
AUTH_REDIS_NAMESPACE=secure-ecommerce-auth

# Estado de identidad de Redis
AUTH_REDIS_STATE_PATH=.secrets/redis/state/state.json

# Configuración alternativa de identidad.
# Mantener vacíos cuando se utiliza STATE_PATH.
AUTH_REDIS_GENERATION=
AUTH_REDIS_EXPECTED_RUN_ID=

# Timeouts de conexión y comandos
AUTH_REDIS_CONNECT_TIMEOUT_MS=1000
AUTH_REDIS_COMMAND_TIMEOUT_MS=1000

# IMPORTANTE:
# No ejecutar recover --invalidate-sessions
# durante un despliegue normal, porque revoca sesiones.


# ============================================================
# 6. GMAIL API - OAUTH 2.0
# ============================================================

# Proveedor de correo para registro y verificación OTP.
# Implementación mediante Gmail API, no SMTP ni Resend.
#
# OAuth 2.0 con permiso exclusivo:
# https://www.googleapis.com/auth/gmail.send
#
# El cliente OAuth se obtiene desde Google Cloud Console.
# Los archivos de credenciales deben permanecer fuera de Git.

# Cliente OAuth descargado desde Google Cloud
GMAIL_CLIENT_PATH=.secrets/gmail/client.json

# Archivo generado después de autorizar Gmail
GMAIL_TOKEN_PATH=.secrets/gmail/token.json

# Cuenta Gmail autorizada para enviar correos
GMAIL_SENDER_EMAIL=

# URI configurada en el cliente OAuth
GMAIL_REDIRECT_URI=http://localhost:3001/oauth2/callback




# ============================================================
# 7. CLOUDINARY - PRODUCT IMAGES
# ============================================================

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=



