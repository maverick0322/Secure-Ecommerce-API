# Plantilla pública de variables de entorno (.env.example)
# Copiar este archivo a .env y configurar las credenciales locales

# Host de Base de Datos MySQL:
# - En ejecución local sin Docker (npm start): DB_HOST=localhost
# - En Docker Compose (1 máquina): DOCKER_DB_HOST=db
# - En presentación distribuida en red (Equipo 2 apuntando a Equipo 1):
#   Colocar la IP del Equipo 1 tanto en DB_HOST como en DOCKER_DB_HOST (ej: 192.168.1.10)
DB_HOST=localhost
DOCKER_DB_HOST=db
DB_DATABASE=mercadolibrenode
DB_USER=mercadolibre_user
DB_PASSWORD=tu_password_segura
DB_PORT=3306

SERVER_PORT=3000
NODE_ENV=development

# Generar con: node -e "console.log(require('crypto').randomBytes(35).toString('hex'))"
JWT_SECRET=tu_clave_secreta_hexadecimal_de_35_bytes

# Orígenes permitidos para CORS (separados por coma). Para clientes en red LAN ej: http://192.168.1.50:8080
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

FILES_IN_BD=false
