# API configuration for the existing final schema. Never run historical seeds here.
# Windows with the published Docker port:
DB_HOST=127.0.0.1
DB_PORT=3307
# Node.js inside the same Docker Compose network:
DOCKER_DB_HOST=db
DOCKER_DB_PORT=3306
DB_DATABASE=secure_ecommerce
DB_USER=ecommerce_app
DB_PASSWORD=

# Set DB_ROOT_PASSWORD separately in the Compose shell when initializing a new volume.
# Migration credentials go in .env.migration.local, based on .env.migration.example.

SERVER_PORT=3000
NODE_ENV=development

# Provision at least 32 CSPRNG bytes in a protected secret manager, as hexadecimal.
# Alternatively: base64url:<canonical unpadded encoding of at least 32 random bytes>.
# No default. Rotation invalidates existing JWTs; do not log the value.
# Checkout quotes still derive their independent HMAC key from this existing value.
# Do not delete or rotate it as part of the RS256 migration: outstanding quotes depend on it.
JWT_SECRET=

# RS256 access authentication: required before starting the updated API.
# No legacy HS256 access-token fallback. Checkout keeps JWT_SECRET separately.
# Server-owned configuration. Relative paths are rooted at this project, NOT cwd.
# Relative files must remain under .secrets; no traversal or symlinks.
# Docker uses explicit /run mounts. Extra managed roots require an operator allowlist.
AUTH_CONFIG_ALLOWED_ROOTS=[]
# PUBLIC_KEYS_PATH is a JSON manifest: kid -> project-relative or allowed absolute PEM.
JWT_RS256_ISSUER=secure-ecommerce-api/access-v2
JWT_RS256_AUDIENCE=secure-ecommerce-clients/access-v2
JWT_RS256_ACTIVE_KID=access-v1
JWT_RS256_PRIVATE_KEY_PATH=.secrets/auth/access-private.pem
JWT_RS256_PUBLIC_KEYS_PATH=.secrets/auth/public-keys.json

# REDIS — local Node.js on Windows/host; required by login and protected endpoints.
# Merge this section into your existing .env; never overwrite local credentials.
# Docker-specific host, port and secret paths are defined separately in compose.yaml.
# No inline credentials. TLS verifies the server certificate.
AUTH_REDIS_HOST=127.0.0.1
AUTH_REDIS_PORT=6380
AUTH_REDIS_TLS=true
AUTH_REDIS_USER=auth_session_app
AUTH_REDIS_PASSWORD_PATH=.secrets/redis/app-password
AUTH_REDIS_CA_PATH=.secrets/redis/ca.crt
AUTH_REDIS_NAMESPACE=secure-ecommerce-auth
# Leave BOTH values empty when using AUTH_REDIS_STATE_PATH (recommended).
# Manual identity configuration is an alternative, never a second source.
AUTH_REDIS_GENERATION=
AUTH_REDIS_EXPECTED_RUN_ID=
# Alternative to the two identity values above: protected operator-owned state JSON.
# Created manually by scripts/redis/control.js recover --invalidate-sessions.
AUTH_REDIS_STATE_PATH=.secrets/redis/state/state.json
# Redis reads its CA explicitly from AUTH_REDIS_CA_PATH, independent of cwd.
# NODE_EXTRA_CA_CERTS is optional global Node trust, read BEFORE JS runs: setting
# it inside the app is too late. Prefer the explicit Redis CA for private Redis TLS.
AUTH_REDIS_CONNECT_TIMEOUT_MS=1000
AUTH_REDIS_COMMAND_TIMEOUT_MS=1000
# Dedicated random binary key (32-128 bytes), outside Git/Docker build context.
AUTH_CREDENTIAL_VERSION_KEY_PATH=.secrets/auth/credential-version.key
# END REDIS

# Verified Resend sender and API key for public email verification.
REGISTRATION_EMAIL_FROM=
RESEND_API_KEY=

# Cloudinary product images. Store secrets outside versioned files.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional persistent directory. Default is log/cloudinary under the API directory.
# CLOUDINARY_CLEANUP_DIR=


# Allowed origins, separated by commas.
CORS_ORIGIN=http://localhost:8080,http://localhost:8081

FILES_IN_DB=false
